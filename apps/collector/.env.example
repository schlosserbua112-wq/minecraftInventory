# Kopie als /etc/minecraft-tracker.env auf dem Pi ablegen (Rechte 600). Diese Datei nie committen.
# mock = Testdaten, live = echter Server (Server-Profile: deploy/server-profiles/*.env.example)
MODE=mock
# Startwert, danach auf der Pi-Kachel einstellbar
POLL_SECONDS=15
HTTP_PORT=8080
# Link "Zur Website" auf der Kachel
SITE_URL=https://minecraft-tracker-eight.vercel.app

# Supabase: Projekt-URL und geheimer Key (nur auf dem Pi!)
SUPABASE_URL=https://plmghcnllggtoihztvhu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Server-Profil (für MODE=live), Vorlage aus deploy/server-profiles einfügen ---
