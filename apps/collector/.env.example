# Kopie als .env auf dem Pi ablegen. Diese Datei nie committen.
# mock = Fake-Daten, live = echter Server (noch nicht fertig)
MODE=mock
POLL_SECONDS=15
HTTP_PORT=8080
# Link der Kachel: Website auf Vercel (sonst zeigt die Kachel die Statusseite)
SITE_URL=

# Supabase: Projekt-URL und service_role-Key (nur auf dem Pi!)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Später für MODE=live
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_WORLD_DIR=/world
