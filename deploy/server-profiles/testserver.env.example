# Server-Profil: lokaler Vanilla-Testserver auf ValePC (C:\Users\valen\mc-testserver)
# Kopie als apps/collector/.env.testserver ablegen, Passwort aus rcon-password.txt eintragen. Nie committen.
SERVER_NAME=Testserver ValePC
MODE=live
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=
WORLD_SOURCE=local
SERVER_DIR=C:\Users\valen\mc-testserver
LEVEL_NAME=world
# Ohne Supabase-Key schreibt der Sammler nur auf die Konsole; Zonen kommen dann aus ZONES
ZONES=[{"name":"Test","dimension":"minecraft:overworld","center_x":0,"center_z":0,"radius":256}]
SETTINGS_FILE=./settings.testserver.json
HTTP_PORT=8101
