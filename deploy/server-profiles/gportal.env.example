# Server-Profil: echter Server bei G-Portal
# Inhalt in /etc/minecraft-tracker.env auf dem Pi übernehmen (Rechte 600). Nie in den Chat, nie committen.
SERVER_NAME=G-Portal
MODE=live
# RCON: Adresse und Port aus dem G-Portal-Panel, enable-rcon=true in server.properties
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=
# FTP nur lesend: Zugangsdaten aus dem G-Portal-Panel
WORLD_SOURCE=ftp
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# true = FTPS (explizit), implicit = FTPS implizit, false = unverschlüsselt
FTP_SECURE=false
# Server-Ordner auf dem FTP (dort liegen server.properties und usercache.json) und Name des Weltordners
SERVER_DIR=/
LEVEL_NAME=world

# Für einen Testlauf auf ValePC (npm run live:gportal) zusätzlich:
SUPABASE_URL=https://plmghcnllggtoihztvhu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SETTINGS_FILE=./settings.gportal.json
HTTP_PORT=8102
